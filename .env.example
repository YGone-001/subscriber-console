# Go API listener. Loopback-only: the Nginx edge is the sole public origin.
HTTP_ADDR=127.0.0.1:18888

MONGODB_URI=mongodb://127.0.0.1:27017/xcloud
MONGODB_XCLOUD_DB=xcloud
MONGODB_APP_DB=xcloud_ops
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=0
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Read-only EPC/5GC UE sources. Roles: mme, amf, smf. Fixed GET paths only.
# Leave empty to keep UE information explicitly unavailable.
UE_INFO_SOURCES=mme=127.0.0.2:9090,amf=127.0.0.5:9090,smf=127.0.0.4:9090

# Absolute path to the per-NF live-topology config manifest (read-only).
# No default root or reference copy is used; leave empty to show runtime nodes only.
NF_ETC_MANIFEST=

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-character-secret

# Must be at least 10 characters and include uppercase, lowercase, number, and symbol.
INITIAL_ADMIN_PASSWORD=ChangeMe@2026

# OCS terminated-contract retention. Default 365; 0 disables physical cleanup.
# OCS_TERMINATED_RETENTION_DAYS=365

# Discovery destination allowlist and scheduled-scan defaults.
# DISCOVERY_ALLOWED_TARGETS=127.0.0.10:7777

# NF Health allowlists and local process bindings.
# NF_HEALTH_ALLOWED_TARGETS=
# NF_HEALTH_SERVICE_UNITS=
# NF_HEALTH_LOCAL_PROCESS_BINDINGS=

# Log workspace sources. A request never names a path; these ids are the only
# vocabulary the browser can reference.
# NF_LOG_DIR=
# NF_LOG_SOURCES=
# NF_LOG_UNITS=
# NF_LOG_SOURCE_BINDINGS=

# Knowledge attachment roots.
# KNOWLEDGE_UPLOAD_DIR=/srv/internal-resource-server/uploads
# KNOWLEDGE_TRASH_DIR=/srv/internal-resource-server/.trash
