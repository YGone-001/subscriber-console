[
  {
    "route": "/system-health",
    "source": "frontend/src/app/(dashboard)/system-health/page.tsx",
    "mode": "operational-mutation-parity",
    "operations": [
      {
        "name": "analytics init",
        "request": "POST /api/analytics/init",
        "authorization": {
          "kind": "role",
          "values": [
            "admin",
            "operator"
          ]
        },
        "confirmation": false,
        "responseSemantics": "computed-snapshot",
        "backendAuthority": "backend/internal/analytics/handler.go",
        "productionReference": "frontend/src/app/(dashboard)/system-health/page.tsx"
      },
      {
        "name": "audit scan",
        "request": "POST /api/system/audit/scan",
        "authorization": {
          "kind": "role",
          "values": [
            "admin",
            "operator"
          ]
        },
        "confirmation": false,
        "responseSemantics": "diagnostic-result",
        "backendAuthority": "backend/internal/system/handler.go",
        "productionReference": "frontend/src/app/(dashboard)/system-health/page.tsx"
      },
      {
        "name": "single heal",
        "request": "POST /api/system/audit/heal",
        "authorization": {
          "kind": "capability",
          "value": "system_heal"
        },
        "confirmation": true,
        "responseSemantics": "mutation-result",
        "backendAuthority": "backend/internal/remediation/handler.go",
        "productionReference": "frontend/src/app/(dashboard)/system-health/page.tsx"
      },
      {
        "name": "batch heal",
        "request": "POST /api/system/audit/batch-heal",
        "authorization": {
          "kind": "capability",
          "value": "system_heal"
        },
        "confirmation": true,
        "responseSemantics": "batch-mutation-result",
        "backendAuthority": "backend/internal/remediation/handler.go",
        "productionReference": "frontend/src/app/(dashboard)/system-health/page.tsx"
      }
    ]
  }
]
