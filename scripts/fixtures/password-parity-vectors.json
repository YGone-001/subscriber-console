[
  {
    "case": "8 ASCII characters",
    "password": "Abcd1234",
    "expected": true
  },
  {
    "case": "7 ASCII characters",
    "password": "Abcd123",
    "expected": false
  },
  {
    "case": "8 BMP Unicode characters",
    "password": "测试密码安全验证",
    "expected": true
  },
  {
    "case": "4 supplementary Unicode characters",
    "password": "😀😀😀😀",
    "expected": false
  },
  {
    "case": "7 supplementary Unicode characters",
    "password": "😀😀😀😀😀😀😀",
    "expected": false
  },
  {
    "case": "8 supplementary Unicode characters",
    "password": "😀😀😀😀😀😀😀😀",
    "expected": true
  },
  {
    "case": "leading/trailing whitespace around 8 characters",
    "password": "  Abcd1234  ",
    "expected": true
  },
  {
    "case": "whitespace-only",
    "password": "          ",
    "expected": false
  },
  {
    "case": "contains username exact case",
    "password": "alice8-password-123",
    "username": "alice8",
    "expected": false
  },
  {
    "case": "contains username different case",
    "password": "XXALICE9XX123",
    "username": "alice9",
    "expected": false
  },
  {
    "case": "exactly 72 UTF-8 bytes",
    "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "expected": true
  },
  {
    "case": "73 UTF-8 bytes",
    "password": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "expected": false
  },
  {
    "case": "multibyte over 72 bytes",
    "password": "密密密密密密密密密密密密密密密密密密密密密密密密密",
    "expected": false
  }
]
