{
  "schemaVersion": 1,
  "routes": [
    "/agents",
    "/agents/:agentId"
  ],
  "managementReadPermission": "core.read",
  "managementWriteCapability": "user_admin",
  "freshActorRequired": true,
  "managementEndpoints": [
    "GET /api/agents",
    "GET /api/agents/{agentId}",
    "POST /api/agents",
    "PUT /api/agents/{agentId}",
    "POST /api/agents/{agentId}/credentials"
  ],
  "machineEndpoints": [
    "POST /api/agent-sessions/{agentId}",
    "POST /api/agent-reports/{agentId}"
  ],
  "machineAuthentication": "Agent credential + server-issued session + sequence",
  "machineCookieFallback": false,
  "businessWrites": false,
  "inventoryWrites": false,
  "networkScopeIsTenantIsolation": false,
  "maximumReportBytes": 131072
}
