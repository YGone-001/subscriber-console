{
  "name": "subscriber-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false --pretty false",
    "lint": "eslint",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "mongo:init": "node scripts/init-mongo-indexes.mjs",
    "mongo:test-core": "node scripts/test-mongo-core.mjs",
    "mongo:perf": "node scripts/check-mongo-query-performance.mjs",
    "clean": "rimraf .next/dev .next/cache .next/types",
    "clean:all": "rimraf .next node_modules/.cache",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "lucide-react": "^1.7.0",
    "mongodb": "^7.4.0",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^2.15.4",
    "swr": "^2.4.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
