{
  "name": "subscriber-console-operations",
  "version": "0.1.0",
  "private": true,
  "description": "Repository-root dependencies for subscriber-console operational scripts.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "mongo:init": "node scripts/init-mongo-indexes.mjs",
    "mongo:import-xcloud": "node scripts/import-xcloud-shell-json.mjs",
    "mongo:migrate-app-db": "node scripts/migrate-app-collections-to-app-db.mjs",
    "mongo:test-core": "node scripts/test-mongo-core.mjs",
    "test:direct-operations": "node scripts/test-direct-operations.mjs",
    "mongo:perf": "node scripts/check-mongo-query-performance.mjs",
    "local:preflight": "node scripts/check-local-preflight.mjs",
    "local:dev": "node scripts/local-dev.mjs",
    "local:status": "node scripts/local-status.mjs",
    "local:doctor": "node scripts/check-local-stack.mjs",
    "local:stop": "node scripts/local-stop.mjs",
    "check:agent-docs-parity": "node scripts/test-agent-docs-parity.mjs",
    "check:fonts": "node scripts/check-font-coverage.mjs",
    "check:ui-parity": "node scripts/test-ui-parity-extractor.mjs && node scripts/test-ui-parity-contract.mjs",
    "test:ui-parity-extractor": "node scripts/test-ui-parity-extractor.mjs",
    "check:ui-forward-port-boundaries": "node scripts/test-ui-forward-port-boundaries.mjs",
    "check:ui-anti-ai-drift": "node scripts/check-ui-anti-ai-drift.mjs",
    "ui:port-manifest": "node scripts/generate-ui-port-manifest.mjs",
    "ui:parity-ceiling": "node scripts/analyse-parity-ceiling.mjs",
    "ui:scan-untranslated": "node scripts/scan-untranslated.mjs",
    "ui:a11y": "node scripts/test-ui-accessibility.mjs",
    "ui:capture": "node scripts/capture-ui-parity.mjs",
    "ui:capture:baseline": "node scripts/capture-ui-parity.mjs --out=.workbuddy-ai/reports/ui-parity-baseline-2026-10-06",
    "docs:sync-agents": "node scripts/sync-agent-docs.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "jiti": "^2.6.1",
    "jose": "^6.2.2",
    "mongodb": "^7.4.0"
  }
}
