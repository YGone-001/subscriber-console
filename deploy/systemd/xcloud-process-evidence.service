[Unit]
Description=xCloud read-only process identity evidence

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/xcloud-process-evidence
RuntimeDirectory=xcloud-process-evidence
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
TimeoutStartSec=10
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@debug @mount @reboot @swap @raw-io @module
ReadWritePaths=/run/xcloud-process-evidence
